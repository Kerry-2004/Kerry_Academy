[Unit]
Description=Kerryht Academy - Frontend Next.js
After=network.target

[Service]
# Remplacez "deploy" par votre utilisateur Linux et adaptez les chemins.
User=deploy
WorkingDirectory=/home/deploy/kerryht-academy/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
# "npm start" lance "next start" (le build doit avoir été fait au préalable
# avec NEXT_PUBLIC_API_URL défini — voir DEPLOY_VPS.md).
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
