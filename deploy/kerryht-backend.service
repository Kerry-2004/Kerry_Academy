[Unit]
Description=Kerryht Academy - Backend Django (Gunicorn)
After=network.target postgresql.service

[Service]
# Remplacez "deploy" par votre utilisateur Linux et adaptez les chemins.
User=deploy
Group=www-data
WorkingDirectory=/home/deploy/kerryht-academy/backend
EnvironmentFile=/home/deploy/kerryht-academy/backend/.env
ExecStart=/home/deploy/kerryht-academy/backend/venv/bin/gunicorn \
    --workers 3 \
    --timeout 120 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
