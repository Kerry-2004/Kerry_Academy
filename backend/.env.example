# Django
SECRET_KEY=change-me-in-a-real-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Base de données (Postgres local via docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kerryht_academy

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Cookie de refresh : "Lax" en local. En production avec frontend (Vercel) et
# backend (Render) sur des domaines racine différents, mettre "None".
REFRESH_COOKIE_SAMESITE=Lax

# --- PRODUCTION (Render) : à définir dans le dashboard Render, PAS ici ---
# SECRET_KEY=<clé aléatoire longue>
# DEBUG=False
# DJANGO_SETTINGS_MODULE=config.settings.prod
# ALLOWED_HOSTS=kerryht-backend.onrender.com,api.kerryht.com
# DATABASE_URL=<fourni automatiquement par la base Render>
# CORS_ALLOWED_ORIGINS=https://kerryht.com,https://www.kerryht.com
# CSRF_TRUSTED_ORIGINS=https://kerryht.com,https://www.kerryht.com
# REFRESH_COOKIE_SAMESITE=None

# --- Phase 4 : Paiements (non utilisé en Phase 1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=

# --- Phase 6 : Vidéo sécurisée (non utilisé en Phase 1) ---
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Phase 7 : Stockage fichiers (non utilisé en Phase 1) ---
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
